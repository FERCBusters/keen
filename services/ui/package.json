{
  "name": "keen-ui",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fercbusters/mosp-design-system": "github:FERCBusters/mosp-design-system#58c7da3706799b06d672d614665d8f53d0654755",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "d3": "7.9.0",
    "html2canvas": "1.4.1",
    "wysi": "github:mdbassit/Wysi#v0.5.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  },
  "scripts": {
    "vendor": "node scripts/vendor-assets.mjs",
