# KEEN security staging instance.
#
# `tools/staging/keen-staging generate-env` writes this file to the checkout's
# .env with fresh random secrets and your public URL. Values in @AT@ markers are
# filled in by that command; edit anything else afterwards.
#
# Every value here is for a disposable installation holding synthetic data.
# Never reuse these secrets, or this file, for an installation with real data.

# keen-staging refuses destructive commands (restore, teardown, init-golden)
# unless this marker is present. Do not add it to any other installation.
STAGING_DESTROYABLE=yes

KEEN_ENV=staging
KEEN_TIMEZONE=Australia/Melbourne
KEEN_PUBLIC_BASE_URL=@URL@

# --- Images ---------------------------------------------------------------------
# Published images by default. To test the checkout itself, set
# KEEN_STAGING_BUILD=1 when running keen-staging; it adds docker-compose.build.yml.
# KEEN_API_IMAGE=ghcr.io/fercbusters/keen-api:1.0.0
# KEEN_UI_IMAGE=ghcr.io/fercbusters/keen-ui:1.0.0

# --- Database and broker --------------------------------------------------------
POSTGRES_PASSWORD=@POSTGRES_PASSWORD@
KEEN_DATABASE_URL=postgresql+psycopg2://keen:${POSTGRES_PASSWORD}@postgres:5432/keen
KEEN_REDIS_PASSWORD=@REDIS_PASSWORD@
KEEN_REDIS_URL=redis://:${KEEN_REDIS_PASSWORD}@valkey:6379/0

# --- Accounts and sessions ------------------------------------------------------
# The administrator the security suite signs in as. It is created on the first
# start of an empty database and then lives in the golden snapshot.
KEEN_BOOTSTRAP_ADMIN_USERNAME=e2e-admin
KEEN_BOOTSTRAP_ADMIN_PASSWORD=@ADMIN_PASSWORD@
KEEN_LOCAL_AUTH_ENABLED=true
# The suite creates single-permission accounts that sign in with passwords only.
# `admins` also works if you supply KEEN_E2E_ADMIN_TOTP_SECRET; `all` does not.
KEEN_MFA_POLICY=optional
KEEN_MFA_ENCRYPTION_KEY=@MFA_KEY@
KEEN_TRUST_REMOTE_USER=false
KEEN_SESSION_COOKIE_NAME=__Host-keen_session
KEEN_SESSION_TTL_SECONDS=86400
KEEN_COOKIE_SECURE=true
KEEN_COOKIE_SAMESITE=lax
KEEN_COOKIE_DOMAIN=
KEEN_CSRF_COOKIE_NAME=keen_csrf
KEEN_CSRF_HEADER_NAME=X-CSRF-Token
KEEN_CSRF_COOKIE_SAMESITE=strict

# Production default is 30 sign-ins per address per five minutes. The suite
# waits out the limit; a higher value shortens runs. Set 30 to test as shipped.
KEEN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
KEEN_LOGIN_RATE_LIMIT_PER_IP=120
KEEN_LOGIN_RATE_LIMIT_PER_USERNAME=15

# TLS front (nginx or Caddy) -> UI nginx -> API. The staging compose override
# pins the UI container and its network gateway (the host side of Docker's
# published port), and KEEN trusts only those two hops. Run the suite from
# another machine so its address is outside this list and the forwarded-address
# checks apply.
KEEN_SECURITY_TRUSTED_PROXY_CIDRS=172.30.65.10/32,172.30.65.1/32

# --- Single sign-on (optional) ----------------------------------------------------
# Configure a test identity provider to run the suite's four OIDC redirect checks.
KEEN_OIDC_ENABLED=false
KEEN_OIDC_AUTO_LINK_EXISTING=false
KEEN_OIDC_AUTO_PROVISION=false
KEEN_GOOGLE_SSO_ENABLED=false
KEEN_GITHUB_SSO_ENABLED=false
KEEN_LDAP_ENABLED=false

# --- Storage and secrets ----------------------------------------------------------
# Local artifact storage lives in a Docker volume that teardown removes.
KEEN_ARTIFACT_STORAGE_BACKEND=local
KEEN_ARTIFACT_LOCAL_DIR=/app/data/artifacts
KEEN_INTEGRATION_SECRET_KEY=@INTEGRATION_KEY@
KEEN_EVENT_DATA_MASKING=false

# --- Collection -------------------------------------------------------------------
# Collectors stay off: the golden data and the suite supply all records, and a
# staging host should not reach out to real systems. Webhooks stay on so their
# secret, replay and rate-limit checks can be exercised.
KEEN_WEBHOOKS_ENABLED=true
KEEN_WEBHOOKS_PATH=/app/config/webhooks.yml
KEEN_WEBHOOKS_REQUIRE_SECRET=true
ENROLL_WEBHOOK_SECRET=@WEBHOOK_SECRET@
KEEN_ISMS_METRICS_WEBHOOK_SECRET=@METRICS_SECRET@
KEEN_RSS_ENABLED=false
KEEN_LOKI_ENABLED=false
KEEN_CLOUDWATCH_LOGS_ENABLED=false
KEEN_ELASTICSEARCH_ENABLED=false
KEEN_GITHUB_ENABLED=false
KEEN_GITLAB_ENABLED=false
KEEN_FORGEJO_ENABLED=false
KEEN_GITEA_ENABLED=false
KEEN_JENKINS_ENABLED=false
KEEN_TAIGA_ENABLED=false
KEEN_BOOKSTACK_ENABLED=false
KEEN_REDMINE_ENABLED=false
KEEN_RISKLEDGER_ENABLED=false
KEEN_GOOGLE_WORKSPACE_ENABLED=false
KEEN_INGESTION_ALLOWED_CIDRS=
KEEN_INTEGRATION_ALLOWED_HOSTS=
KEEN_INTEGRATION_PRIVATE_CIDRS=

# --- Outbound notifications ---------------------------------------------------------
# Leave SMTP and notification webhooks empty so test activity sends nothing.
KEEN_SMTP_HOST=
KEEN_QUESTION_WEBHOOK_GENERIC_URLS=
KEEN_INCIDENT_WEBHOOK_URL=
